@page "/"
@using System.Net.Http.Json
@using System.Net
@using System.Text.Json.Serialization
@using System.Text.RegularExpressions;
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient

<PageTitle>XYZ Icons - Search 8000+ Official Cloud Icons</PageTitle>

<div class="app-root @(hasSearched ? "has-results" : "")">
    <div class="sr-only" aria-live="polite" aria-atomic="true">@liveAnnouncement</div>

    <!-- Google-style centered hero (shrinks on search) -->
    <div class="hero">
        <div class="logo">
            <span class="logo-icon">☁️</span>
            <h1 class="logo-text">xyz<span class="logo-accent">icon</span></h1>
        </div>
        <p class="tagline">Search 8,000+ official cloud service icons</p>

        <!-- Search bar -->
        <div class="search-bar">
            <svg class="search-bar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input type="text"
                   @ref="searchInput"
                                     id="main-search-input"
                   @bind="searchTerm"
                   @bind:event="oninput"
                                     @onkeydown="OnSearchKeyDown"
                   @onkeyup="OnSearchKeyUp"
                   placeholder="Search icons…"
                                     aria-label="Search icons"
                     class="search-input" />
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button @onclick="ClearSearch" class="search-clear" title="Clear">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M18 6 6 18M6 6l12 12"/>
                    </svg>
                </button>
            }
        </div>

        @if (hasSearched)
        {
            <div class="search-toolbar">
                <span class="result-count">@filteredIcons.Count of @totalIconsLoaded</span>
                <button class="toolbar-btn @(showFilters ? "active" : "")" @onclick="ToggleFilters" title="Filter providers">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                    </svg>
                    Filters
                </button>
                <div class="format-switch">
                    <button class="fmt-btn @(!DownloadAsPng ? "active" : "")" @onclick="() => DownloadAsPng = false">SVG</button>
                    <button class="fmt-btn @(DownloadAsPng ? "active" : "")" @onclick="() => DownloadAsPng = true">PNG</button>
                </div>
            </div>

            @if (showFilters)
            {
                <div class="filter-bar">
                    @foreach (var provider in providers)
                    {
                        <button class="pill @(selectedProviders[provider.Key] ? "active" : "")"
                                @onclick="() => ToggleProvider(provider.Key)">
                            @provider.Value
                        </button>
                    }
                    @if (selectedProviders.Values.Any(v => !v))
                    {
                        <button class="pill reset-pill" @onclick="SelectAllProviders">Reset</button>
                    }
                </div>
            }
        }
    </div>

    <!-- Loading -->
    @if (isLoading)
    {
        <div class="results loading-results">
            <p class="loading-label">@loadingMessage</p>
            <div class="skeleton-grid">
                @for (var i = 0; i < 12; i++)
                {
                    <div class="skeleton-card">
                        <div class="skeleton-image"></div>
                        <div class="skeleton-line"></div>
                        <div class="skeleton-line short"></div>
                    </div>
                }
            </div>
        </div>
    }
    else if (allIcons.Count == 0)
    {
        <div class="state-msg">
            <p>Something went wrong. Please refresh.</p>
        </div>
    }
    else if (hasSearched && filteredIcons.Count == 0)
    {
        <div class="state-msg">
            <p class="state-big">No icons found</p>
            <p>Try different keywords or adjust provider filters.</p>
            @if (selectedProviders.Values.Any(v => !v))
            {
                <button class="btn-reset" @onclick="SelectAllProviders">Clear filters</button>
            }
            <button class="btn-reset" @onclick="ResetSearch">Reset</button>
        </div>
    }
    else if (hasSearched)
    {
        <div class="results">
            <div class="grid">
                @for (var i = 0; i < displayedIcons.Count; i++)
                {
                    var icon = displayedIcons[i];
                    var safeId = GenerateSafeId(icon.Name);
                    <div id="card-@safeId" class="card @(activeCardIndex == i ? "active" : "")" tabindex="0" @onfocus="() => SetActiveCard(i)">
                        <div class="card-img">
                            <img id="@safeId"
                                 src="@icon.Path"
                                 alt="@icon.DisplayName"
                                 loading="lazy"
                                 decoding="async"
                                 fetchpriority="low"
                                 class="icon-img" />
                        </div>
                        <div class="card-body">
                            <span class="card-title" title="@icon.DisplayName">@((MarkupString)HighlightMatch(icon.DisplayName))</span>
                        </div>
                        <div class="card-actions">
                            <button class="action-btn" @onclick:stopPropagation="true"
                                    @onclick="() => OnDownloadRequested(safeId, icon.Name, icon.DisplayName)"
                                    title="Download">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
                                </svg>
                                @GetDownloadButtonLabel(safeId)
                            </button>
                            <button class="action-btn" @onclick:stopPropagation="true"
                                    @onclick="() => OnCopyRequested(safeId, icon.Name, icon.DisplayName)"
                                    title="Copy to clipboard">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                </svg>
                                @GetCopyButtonLabel(safeId)
                            </button>
                        </div>
                    </div>
                }
            </div>

            @if (hasMoreToDisplay)
            {
                <div class="sentinel" id="scroll-sentinel"></div>
                <div class="loading-more">
                    <div class="skeleton-grid skeleton-grid--inline">
                        @for (var i = 0; i < 6; i++)
                        {
                            <div class="skeleton-card">
                                <div class="skeleton-image"></div>
                                <div class="skeleton-line"></div>
                                <div class="skeleton-line short"></div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="explore">
            <div class="explore-grid">
                @foreach (var icon in previewIcons)
                {
                    <div class="explore-card" @onclick="() => OnPreviewClick(icon)" title="@icon.DisplayName">
                        <img src="@icon.Path" alt="@icon.DisplayName" loading="lazy" />
                    </div>
                }
            </div>
        </div>
    }

</div>

@implements IDisposable

@code {
    private ElementReference searchInput;
    private string searchTerm = string.Empty;
    private List<IconData> allIcons = new();
    private List<IconData> filteredIcons = new();
    private List<IconData> displayedIcons = new();
    private List<IconData> previewIcons = new();
    private int displayCount = 60;
    private readonly int displayIncrement = 60;
    private int totalIconsLoaded = 0;
    private bool hasMoreToDisplay = false;
    private bool hasSearched = false;
    private bool showFilters = false;
    private bool DownloadAsPng { get; set; }
    private bool isLoading = true;
    private string loadingMessage = "Loading icons…";
    private string liveAnnouncement = string.Empty;
    private int activeCardIndex = -1;
    private string? lastCopiedSafeId;
    private string? lastDownloadedSafeId;
    private System.Timers.Timer? debounceTimer;
    private DotNetObjectReference<Index>? dotNetRef;
    private bool searchEngineReady = false;

    private int SelectedProviderCount => selectedProviders.Values.Count(v => v);

    private Dictionary<string, string> providers = new()
    {
        { "azure", "Azure" },
        { "aws", "AWS" },
        { "gcp", "Google Cloud" },
        { "fabric", "Fabric" },
        { "microsoft365", "Microsoft 365" },
        { "powerplatform", "Power Platform" },
        { "dynamics365", "Dynamics 365" },
        { "entra", "Entra" }
    };

    private Dictionary<string, bool> selectedProviders = new();

    protected override async Task OnInitializedAsync()
    {
        debounceTimer = new System.Timers.Timer(120);
        debounceTimer.Elapsed += async (_, _) => await OnDebounce();
        debounceTimer.AutoReset = false;

        foreach (var provider in providers.Keys)
            selectedProviders[provider] = true;

        await LoadAllIconsMetadata();

        // Pick some preview icons
        RandomizePreviewIcons();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("xyzicon.initInfiniteScroll", dotNetRef);
            try { await searchInput.FocusAsync(); } catch { }
        }

        // Re-observe sentinel whenever results change
        if (hasSearched && hasMoreToDisplay)
        {
            try { await JSRuntime.InvokeVoidAsync("xyzicon.observeSentinel"); } catch { }
        }
    }

    [JSInvokable]
    public void LoadMoreFromJS()
    {
        InvokeAsync(() =>
        {
            LoadMore();
            StateHasChanged();
        });
    }

    private async Task LoadAllIconsMetadata()
    {
        try
        {
            isLoading = true;
            allIcons.Clear();
            StateHasChanged();

            var tasks = providers.Select(async p =>
            {
                try
                {
                    var response = await HttpClient.GetFromJsonAsync<IconsMetadata>($"data/{p.Key}.json");
                    if (response?.Icons != null)
                    {
                        return response.Icons.Select(icon => new IconData
                        {
                            Name = icon.Name,
                            DisplayName = CleanIconName(icon.Name),
                            Path = icon.Path,
                            FileName = icon.FileName,
                            Provider = p.Key,
                            ProviderName = p.Value,
                            Category = ExtractCategory(icon.Path),
                            SearchText = BuildSearchText(icon.Name, p.Value, icon.Path)
                        }).ToList();
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading {p.Key}: {ex.Message}");
                }
                return new List<IconData>();
            });

            var results = await Task.WhenAll(tasks);
            foreach (var batch in results)
                allIcons.AddRange(batch);

            totalIconsLoaded = allIcons.Count;
            loadingMessage = $"Loaded {totalIconsLoaded} icons";

            // ===== INITIALIZE JAVASCRIPT SEARCH ENGINE =====
            await InitializeSearchEngine();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading icons: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task InitializeSearchEngine()
    {
        try
        {
            // Convert to minimal data structure for transfer
            var searchData = allIcons.Select(icon => new
            {
                icon.Name,
                icon.DisplayName,
                icon.Provider,
                icon.SearchText,
                icon.Path,
                icon.FileName
            }).ToList();

            await JSRuntime.InvokeVoidAsync("xyzicon.searchEngine.initIndex", searchData);
            searchEngineReady = true;
            Console.WriteLine("[xyzicon] JavaScript search engine initialized");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing search engine: {ex.Message}");
        }
    }

    private string BuildSearchText(string name, string providerName, string path)
    {
        var clean = CleanIconName(name).ToLowerInvariant();
        var cat = ExtractCategory(path);
        var acronyms = ExtractAcronyms(clean);
        return $"{clean} {name.ToLowerInvariant()} {providerName.ToLowerInvariant()} {cat} {acronyms}";
    }

    private string ExtractAcronyms(string text)
    {
        // Extract first letters of each word as potential acronym
        var words = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length > 1)
        {
            var acronym = string.Concat(words.Select(w => w[0]));

            // Common cloud acronym expansions
            var commonExpansions = GetAcronymExpansions(text);
            return $"{acronym} {commonExpansions}";
        }
        return string.Empty;
    }

    private string GetAcronymExpansions(string text)
    {
        // Map of common cloud service acronyms
        var acronymMap = new Dictionary<string, string>
        {
            { "kubernetes", "k8s aks eks gke" },
            { "azure kubernetes service", "aks" },
            { "elastic kubernetes service", "eks" },
            { "google kubernetes engine", "gke" },
            { "virtual machine", "vm" },
            { "virtual network", "vnet" },
            { "database", "db" },
            { "application", "app" },
            { "application insights", "ai appinsights" },
            { "api management", "apim" },
            { "azure devops", "ado" },
            { "container", "aci acr aks" },
            { "authentication", "auth aad entra" },
            { "active directory", "ad aad" },
            { "storage account", "storage sa" },
            { "virtual desktop", "avd" },
            { "machine learning", "ml aml" },
            { "artificial intelligence", "ai" },
            { "service bus", "sb asb" },
            { "event hub", "eh aeh" },
            { "cognitive services", "cog" },
            { "developer", "dev" },
            { "operations", "ops" },
            { "production", "prod" },
        };

        var lowerText = text.ToLowerInvariant();
        var matches = acronymMap
            .Where(kvp => lowerText.Contains(kvp.Key))
            .Select(kvp => kvp.Value);

        return string.Join(" ", matches);
    }

    private static string CleanIconName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";

        var cleaned = name;

        // Strip leading dots and special chars
        cleaned = Regex.Replace(cleaned, @"^[.\-_]+", "");

        // Strip numeric prefixes like "00698-icon-service-"
        cleaned = Regex.Replace(cleaned, @"^\d+-icon-service-", "", RegexOptions.IgnoreCase);

        // Also handle patterns like "12345-icon-" without "service"
        cleaned = Regex.Replace(cleaned, @"^\d+-icon-", "", RegexOptions.IgnoreCase);

        // Strip remaining leading digits + dash
        cleaned = Regex.Replace(cleaned, @"^\d+-", "");

        // Strip any leading dots/dashes/underscores again (after other stripping)
        cleaned = Regex.Replace(cleaned, @"^[.\-_]+", "");

        // Replace dashes/underscores with spaces
        cleaned = cleaned.Replace("-", " ").Replace("_", " ");

        // Remove file extensions
        cleaned = Regex.Replace(cleaned, @"\.(svg|png)$", "", RegexOptions.IgnoreCase);

        // Strip leading/trailing whitespace and dots
        cleaned = cleaned.Trim();
        cleaned = cleaned.Trim('.', '-', '_', ' ');

        // Collapse multiple whitespace
        cleaned = Regex.Replace(cleaned, @"\s+", " ").Trim();

        // Title-case each word
        if (!string.IsNullOrEmpty(cleaned))
        {
            cleaned = string.Join(" ", cleaned.Split(' ')
                .Where(w => !string.IsNullOrWhiteSpace(w))
                .Select(w => w.Length > 0 ? char.ToUpper(w[0]) + (w.Length > 1 ? w.Substring(1).ToLowerInvariant() : "") : ""));
        }

        return cleaned;
    }

    private async Task FilterIcons()
    {
        if (!searchEngineReady)
        {
            filteredIcons.Clear();
            displayCount = displayIncrement;
            UpdateDisplayedIcons();
            return;
        }

        try
        {
            // Get enabled providers as dictionary for JavaScript
            var enabledProviders = selectedProviders.ToDictionary(kv => kv.Key, kv => kv.Value);

            // Call JavaScript search engine (ultra-fast!)
            var searchResults = await JSRuntime.InvokeAsync<List<SearchResultItem>>("xyzicon.searchEngine.search", searchTerm, enabledProviders);

            // Convert typed JS results back to IconData for display
            filteredIcons = searchResults?
                .Select(r => allIcons.FirstOrDefault(icon => icon.Name == r.Id))
                .OfType<IconData>()
                .ToList() ?? new List<IconData>();

            await JSRuntime.InvokeVoidAsync("xyzicon.searchEngine.recordQueryOutcome", searchTerm, filteredIcons.Count);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in FilterIcons: {ex.Message}");
            filteredIcons.Clear();
        }

        displayCount = displayIncrement;
        UpdateDisplayedIcons();
        activeCardIndex = displayedIcons.Count > 0 ? 0 : -1;
        AnnounceResultCount();
    }

    private void UpdateDisplayedIcons()
    {
        displayedIcons = filteredIcons.Take(displayCount).ToList();
        hasMoreToDisplay = displayCount < filteredIcons.Count;

        if (displayedIcons.Count == 0)
            activeCardIndex = -1;
        else if (activeCardIndex >= displayedIcons.Count)
            activeCardIndex = displayedIcons.Count - 1;
    }

    private void LoadMore()
    {
        displayCount += displayIncrement;
        UpdateDisplayedIcons();
    }

    private string ExtractCategory(string path)
    {
        try
        {
            var parts = path.Split('/');
            if (parts.Length > 2)
            {
                return string.Join(" ", parts.Skip(2).Take(Math.Max(0, parts.Length - 3)))
                    .ToLower().Replace("-", " ").Replace("+", " ").Trim();
            }
        }
        catch { }
        return string.Empty;
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await ClearSearch();
            return;
        }

        if (!hasSearched || displayedIcons.Count == 0)
            return;

        if (e.Key == "ArrowDown")
        {
            activeCardIndex = Math.Min(displayedIcons.Count - 1, activeCardIndex + 1);
            await ScrollActiveCardIntoView();
            return;
        }

        if (e.Key == "ArrowUp")
        {
            activeCardIndex = Math.Max(0, activeCardIndex - 1);
            await ScrollActiveCardIntoView();
            return;
        }

        if (e.Key == "Enter" && activeCardIndex >= 0 && activeCardIndex < displayedIcons.Count)
        {
            var icon = displayedIcons[activeCardIndex];
            await OnCopyRequested(GenerateSafeId(icon.Name), icon.Name, icon.DisplayName);
        }
    }

    private async Task ScrollActiveCardIntoView()
    {
        if (activeCardIndex < 0 || activeCardIndex >= displayedIcons.Count)
            return;

        var activeIcon = displayedIcons[activeCardIndex];
        await JSRuntime.InvokeVoidAsync("xyzicon.scrollToCard", $"card-{GenerateSafeId(activeIcon.Name)}");
        StateHasChanged();
    }

    private async Task OnDebounce()
    {
        await InvokeAsync(async () =>
        {
            hasSearched = !string.IsNullOrWhiteSpace(searchTerm) ||
                          selectedProviders.Values.Any(v => !v);
            await FilterIcons();
            StateHasChanged();
        });
    }

    private async Task ToggleProvider(string provider)
    {
        selectedProviders[provider] = !selectedProviders[provider];
        hasSearched = true;
        showFilters = true;
        await JSRuntime.InvokeVoidAsync("xyzicon.searchEngine.clearCache");
        await FilterIcons();
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private async Task SelectAllProviders()
    {
        foreach (var provider in providers.Keys)
            selectedProviders[provider] = true;

        hasSearched = !string.IsNullOrWhiteSpace(searchTerm);
        await JSRuntime.InvokeVoidAsync("xyzicon.searchEngine.clearCache");
        await FilterIcons();
    }

    private async Task ClearAllProviders()
    {
        foreach (var provider in providers.Keys)
            selectedProviders[provider] = false;

        hasSearched = true;
        await JSRuntime.InvokeVoidAsync("xyzicon.searchEngine.clearCache");
        await FilterIcons();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        hasSearched = selectedProviders.Values.Any(v => !v);
        await JSRuntime.InvokeVoidAsync("xyzicon.searchEngine.clearCache");
        await FilterIcons();
        liveAnnouncement = "Search cleared.";
    }

    private async Task ResetSearch()
    {
        searchTerm = string.Empty;
        hasSearched = false;
        foreach (var provider in providers.Keys)
            selectedProviders[provider] = true;
        filteredIcons.Clear();
        displayedIcons.Clear();
        activeCardIndex = -1;
        showFilters = false;
        await JSRuntime.InvokeVoidAsync("xyzicon.searchEngine.clearCache");
        RandomizePreviewIcons();
        liveAnnouncement = "Search and filters reset.";
    }

    private void RandomizePreviewIcons()
    {
        if (allIcons.Count == 0)
        {
            previewIcons.Clear();
            return;
        }

        var rng = new Random();
        previewIcons = allIcons.OrderBy(_ => rng.Next()).Take(48).ToList();
    }

    private async Task OnPreviewClick(IconData icon)
    {
        searchTerm = icon.DisplayName;
        hasSearched = true;
        await FilterIcons();
    }

    private void SetActiveCard(int index)
    {
        activeCardIndex = index;
    }

    private string GenerateSafeId(string name)
    {
        return "ic_" + Regex.Replace(name, @"[^a-zA-Z0-9]+", "_");
    }

    private string GetProviderLabel(string providerKey)
    {
        return providers.GetValueOrDefault(providerKey, providerKey);
    }

    private static string GetButtonSuccessLabel(string defaultLabel, bool isSuccess)
    {
        return isSuccess ? "✓" : defaultLabel;
    }

    private string GetDownloadButtonLabel(string safeId)
    {
        var defaultLabel = DownloadAsPng ? "PNG" : "SVG";
        return GetButtonSuccessLabel(defaultLabel, lastDownloadedSafeId == safeId);
    }

    private string GetCopyButtonLabel(string safeId)
    {
        return GetButtonSuccessLabel("Copy", lastCopiedSafeId == safeId);
    }

    private string HighlightMatch(string text)
    {
        var encoded = WebUtility.HtmlEncode(text);
        if (string.IsNullOrWhiteSpace(searchTerm))
            return encoded;

        var terms = searchTerm
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim())
            .Where(t => t.Length > 1)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var term in terms)
        {
            encoded = Regex.Replace(
                encoded,
                Regex.Escape(WebUtility.HtmlEncode(term)),
                m => $"<mark class=\"match\">{m.Value}</mark>",
                RegexOptions.IgnoreCase);
        }

        return encoded;
    }

    private async Task FlashCopyState(string safeId)
    {
        lastCopiedSafeId = safeId;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1400);
        if (lastCopiedSafeId == safeId)
        {
            lastCopiedSafeId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FlashDownloadState(string safeId)
    {
        lastDownloadedSafeId = safeId;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1400);
        if (lastDownloadedSafeId == safeId)
        {
            lastDownloadedSafeId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnDownloadRequested(string safeId, string iconId, string displayName)
    {
        bool success;
        if (DownloadAsPng)
            success = await JSRuntime.InvokeAsync<bool>("downloadAsPng", safeId, displayName);
        else
            success = await JSRuntime.InvokeAsync<bool>("downloadAsSvg", safeId, displayName);

        if (success)
        {
            await JSRuntime.InvokeVoidAsync("xyzicon.searchEngine.recordIconUse", iconId);
            liveAnnouncement = $"Downloaded {displayName} as {(DownloadAsPng ? "PNG" : "SVG")}.";
            _ = FlashDownloadState(safeId);
        }
    }

    private async Task OnCopyRequested(string safeId, string iconId, string displayName)
    {
        var success = await JSRuntime.InvokeAsync<bool>("copyImageToClipboard", safeId, displayName);
        if (success)
        {
            await JSRuntime.InvokeVoidAsync("xyzicon.searchEngine.recordIconUse", iconId);
            liveAnnouncement = $"Copied {displayName} to clipboard.";
            _ = FlashCopyState(safeId);
        }
    }

    private void AnnounceResultCount()
    {
        if (isLoading)
            return;

        if (!hasSearched)
        {
            liveAnnouncement = $"Ready. {totalIconsLoaded} icons available.";
            return;
        }

        liveAnnouncement = filteredIcons.Count == 0
            ? "No icons found."
            : $"Showing {filteredIcons.Count} results.";
    }

    private class IconData
    {
        public string Name { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Path { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string ProviderName { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string SearchText { get; set; } = string.Empty;
    }

    private class SearchResultItem
    {
        [JsonPropertyName("id")]
        public string Id { get; set; } = string.Empty;
    }

    private class SvgFile
    {
        [JsonPropertyName("path")]
        public string Path { get; set; } = string.Empty;

        [JsonPropertyName("name")]
        public string Name { get; set; } = string.Empty;

        [JsonPropertyName("fileName")]
        public string FileName { get; set; } = string.Empty;
    }

    private class IconsMetadata
    {
        public string Category { get; set; } = string.Empty;
        public int Count { get; set; }
        public List<SvgFile> Icons { get; set; } = new();
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
        dotNetRef?.Dispose();
    }
}
